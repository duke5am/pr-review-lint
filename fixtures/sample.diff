+++ b/src/api/handlers.py
@@ -1,12 +1,34 @@
 """HTTP handlers for the public API."""

 import hashlib
 import logging
+import os
+import sqlite3

 from flask import Blueprint, jsonify, request

 log = logging.getLogger(__name__)
 bp = Blueprint("api", __name__)

+DB_PATH = os.environ.get("DB_PATH", "/var/lib/app/app.db")
+
+
+def search_users(query):
+    conn = sqlite3.connect(DB_PATH)
+    cur = conn.cursor()
+    sql = "SELECT id, email, display_name FROM users WHERE display_name LIKE '%" + query + "%'"
+    cur.execute(sql)
+    rows = cur.fetchall()
+    return [{"id": r[0], "email": r[1], "name": r[2]} for r in rows]
+
+
+def get_api_token():
+    return os.environ.get("SERVICE_API_TOKEN", "dev-token-please-change")
+
+
 @bp.route("/healthz")
 def healthz():
     return jsonify({"ok": True})
+
+
+@bp.route("/users")
+def users():
+    q = request.args.get("q", "")
+    results = search_users(q)
+    log.info("search for %s returned %d rows", q, len(results))
+    return jsonify({"results": results, "token": get_api_token()})
