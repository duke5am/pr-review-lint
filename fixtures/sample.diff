 import React from "react";

+const API_BASE = "https://internal-api.example.com/v1";
+const CACHE: Record<string, unknown> = {};
+
+function formatBytes(n: number): string {
+  return `${(n / 1024 / 1024).toFixed(2)} MB`;
+}
+
 export function Dashboard({ userId }: { userId: string }) {
+  // also fixed the unrelated typo in the footer while I was here
+  const unusedHelper = formatBytes(0);
+  const [rows, setRows] = React.useState<unknown[]>([]);
+  React.useEffect(() => {
+    fetch(`${API_BASE}/users/${userId}/rows`)
+      .then((r) => r.json())
+      .then((data) => {
+        CACHE[userId] = data;
+        setRows(data.rows);
+      });
+  }, [userId]);
+
   return (
-    <div className="dashboard">
-      <h1>Dashboard</h1>
+    <div className="dashboard" style={{ padding: 16 }}>
+      <h1>Dashboard for {userId}</h1>
+      <table>
+        {rows.map((row: any, i) => (
+          <tr key={i}>
+            <td>{row.name}</td>
+            <td>{row.total}</td>
+          </tr>
+        ))}
+      </table>
     </div>
   );
 }
+
+export function Footer() {
+  return <footer>© Example Inc</footer>;
+}
